  m_Script: {fileID: 11500000, guid: e159b0cc2492fbe4386f1c7f3eb38e91, type: 3}
  m_Name: Ming-hong
  m_EditorClassIdentifier: 
  lines:
  - "\u300C\u4F60\u7D42\u65BC\u4F86\u4E86\u3002\u4E0D\u662F\u6BCF\u500B\u4EBA\u90FD\u80FD\u8D70\u5230\u9019\u88E1\u3002 
    \u9019\u584A\u77F3\u677F\uFF0C\u4E0D\u53EA\u662F\u6821\u5712\u7684\u4E00\u90E8\u5206\uFF0C\u800C\u662F\u4E00\u6BB5\u9078\u64C7\u7684\u898B\u8B49\u3002\u904E\u53BB\u7684\u4EBA\u7559\u4E0B\u5370\u8A18\uFF0C\u662F\u70BA\u4E86\u7B49\u5F85\u4E0B\u4E00\u500B\u503C\u5F97\u7684\u4EBA\u3002"
  - "\u6211\u4E0D\u662F\u4F86\u963B\u6B62\u4F60\uFF0C\u4E5F\u4E0D\u662F\u4F86\u5E6B\u52A9\u4F60\u3002\u6211\u53EA\u662F\u898B\u8B49\u3002\u898B\u8B49\u4F60\u662F\u5426\u80FD\u5920\u627F\u63A5\u9019\u6BB5\u6B77\u53F2\u3002"
  - "\u73FE\u5728\uFF0C\u5C07\u4F60\u4E00\u8DEF\u6536\u96C6\u7684\u7D00\u9304\u788E\u7247\u3001\u5B78\u9577\u59CA\u5011\u7684\u7DDA\u7D22\uFF0C\u5168\u90E8\u653E\u5728\u77F3\u677F\u524D\u3002\u8B93\u5B83\u6C7A\u5B9A\uFF0C\u4F60\u662F\u5426\u6709\u8CC7\u683C\u7E7C\u627F\u9019\u9053\u5149\u3002\u300D"
