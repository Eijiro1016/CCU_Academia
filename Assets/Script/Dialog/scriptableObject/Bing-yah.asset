  m_Script: {fileID: 11500000, guid: e159b0cc2492fbe4386f1c7f3eb38e91, type: 3}
  m_Name: Bing-yah
  m_EditorClassIdentifier: 
  lines:
  - "\u300C\u2026\u2026\u4F60\u624B\u4E0A\u90A3\u4EFD\u7D00\u9304\uFF0C\u6211\u770B\u904E\u3002\u4E0D\u904E\u9019\u4E0D\u662F\u5B8C\u6574\u7684\u7248\u672C\uFF0C\u771F\u6B63\u7684\u7D00\u9304\u5728\u88AB\u5C01\u5B58\u524D\uFF0C\u66FE\u7D93\u52A0\u5BC6\u5132\u5B58\u904E\u4E00\u6B21\u3002"
  - "\u6211\u7576\u5E74\u662F\u7A0B\u8A2D\u8AB2\u7684\u52A9\u6559\uFF0C\u525B\u597D\u88AB\u8ACB\u4F86\u5E6B\u5FD9\u89E3\u78BC\u90A3\u6BB5\u5947\u602A\u7684\u8CC7\u6599\u3002\u5B83\u4E0D\u662F\u666E\u901A\u7684\u52A0\u5BC6\u6587\u5B57\uFF0C\u66F4\u50CF\u662F\u4E00\u7A2E\u5D4C\u5728\u6821\u5712\u5730\u5716\u88E1\u7684\u2018\u8DEF\u5F91\u6F14\u7B97\u6CD5\u2019\u3002"
  - "\u60F3\u627E\u5230\u6700\u5F8C\u7684\u7B54\u6848\uFF0C\u4F60\u5F97\u524D\u5F80\u9CF3\u68A8\u4E2D\u5EAD\uFF0C\u90A3\u88E1\u6709\u4E00\u500B\u5F9E\u6C92\u88AB\u5217\u5165\u6821\u5340\u5B98\u65B9\u5730\u5716\u7684\u89D2\u843D\u2014\u2014\u2018\u6620\u5F71\u77F3\u677F\u2019\u3002\u4F46\u90A3\u88E1\u53EA\u6709\u5728\u7279\u5B9A\u6642\u9593\uFF0C\u624D\u80FD\u770B\u5230\u8A18\u865F\u51FA\u73FE\u3002"
  - "\u800C\u771F\u6B63\u80FD\u89E3\u958B\u90A3\u584A\u77F3\u677F\u5C01\u5370\u7684\uFF0C\u662F\u50B3\u8AAA\u4E2D\u7684\u82F1\u96C4\u2026\u2026\u9298\u5B8F\u3002\u6211\u5011\u90FD\u53EB\u4ED6\u2014\u2014\u5B88\u8B77\u8005\u4E4B\u5F71\u3002\u300D"
