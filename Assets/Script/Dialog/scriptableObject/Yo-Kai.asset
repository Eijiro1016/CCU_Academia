  m_Script: {fileID: 11500000, guid: e159b0cc2492fbe4386f1c7f3eb38e91, type: 3}
  m_Name: Yo-Kai
  m_EditorClassIdentifier: 
  lines:
  - "\u300C\u4F60\u662F\u65B0\u4F86\u7684\u5B78\u751F\u5427\uFF1F\u770B\u8D77\u4F86\u548C\u67D0\u500B\u50B3\u8AAA\u4E2D\u7684\u4EBA\u5F88\u50CF\u5462\u2026\u2026 
    \u6211\u5011\u5B78\u751F\u6703\u524D\u9663\u5B50\u6574\u7406\u8CC7\u6599\u6642\uFF0C\u7121\u610F\u9593\u767C\u73FE\u4E00\u5C01\u6C92\u7F72\u540D\u7684\u4FE1\uFF0C\u4FE1\u88E1\u63D0\u5230\u4E86\u300E\u9CF3\u68A8\u5370\u8A18\u300F\u9019\u500B\u8A5E\u3002\u4F60\u77E5\u9053\u55CE\uFF1F\u64DA\u8AAA\u9019\u500B\u5370\u8A18\u8DDF\u9CF3\u68A8\u5927\u5B78\u904E\u53BB\u7684\u67D0\u500B\u2018\u5B88\u8B77\u8005\u2019\u6709\u95DC\u3002"
  - "\u9019\u4E9B\u5167\u5BB9\u90FD\u592A\u8A6D\u7570\uFF0C\u6211\u5011\u4E5F\u6C92\u591A\u8FFD\u67E5\u3002\u4E0D\u904E\u6709\u500B\u4EBA\u61C9\u8A72\u6703\u611F\u8208\u8DA3\u3002\u4F60\u53EF\u4EE5\u53BB\u6587\u5B78\u9662\u627E\u627E\u5DE7\u84C9\u5B78\u59CA\uFF0C\u4ED6\u662F\u6821\u53F2\u7814\u7A76\u793E\u7684\u793E\u54E1\uFF0C\u5C0D\u9019\u985E\u5947\u602A\u7684\u6B77\u53F2\u7279\u5225\u8457\u8FF7\u3002\u300D"
