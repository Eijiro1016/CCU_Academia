  m_Name: chao-rong
  m_EditorClassIdentifier: 
  lines:
  - "\u300C\u4F60\u8AAA\u2026\u2026\u9CF3\u68A8\u5370\u8A18\uFF1F\u90A3\u500B\u540D\u5B57\u6211\u53EA\u5728\u4E00\u672C\u8001\u8A69\u96C6\u7684\u908A\u89D2\u770B\u904E\u3002"
  - "\u64DA\u8AAA\u5F88\u4E45\u4EE5\u524D\uFF0C\u6709\u4E00\u7FA4\u5B78\u751F\u7D44\u6210\u4E86\u79D8\u5BC6\u7814\u7A76\u5C0F\u7D44\uFF0C\u60F3\u8FFD\u67E5\u9CF3\u68A8\u5927\u5B78\u904E\u53BB\u7684\u67D0\u6BB5\u88AB\u5875\u5C01\u7684\u6B77\u53F2\u3002\u4ED6\u5011\u7684\u64DA\u9EDE\u5C31\u5728\u5DE5\u5B78\u9662\u7684\u5730\u4E0B\u5BE6\u9A57\u5BA4\uFF0C\u53EA\u6709\u5C11\u6578\u4EBA\u77E5\u9053\u90A3\u88E1\u7684\u771F\u6B63\u7528\u9014\u3002"
  - "\u5176\u4E2D\u6709\u4E00\u4F4D\u5B78\u9577\u53EB\u79AE\u5FB7\uFF0C\u4ED6\u662F\u7576\u5E74\u90A3\u500B\u5C0F\u7D44\u88E1\u552F\u4E00\u9084\u5728\u6821\u5712\u88E1\u7559\u6709\u8E64\u8DE1\u7684\u4EBA\u3002\u96D6\u7136\u5DF2\u7D93\u4E0D\u5E38\u9732\u9762\uFF0C\u4F46\u6211\u807D\u8AAA\u4ED6\u5076\u723E\u6703\u5728\u5DE5\u5B78\u9662\u5F8C\u68DF\u5730\u4E0B\u901A\u9053\u9644\u8FD1\u51FA\u6C92\uFF0C\u6574\u7406\u4E00\u4E9B\u820A\u8A2D\u5099\u3002"
  - "\u5982\u679C\u4F60\u771F\u7684\u60F3\u77E5\u9053\u95DC\u65BC\u9CF3\u68A8\u5370\u8A18\u7684\u4E8B\uFF0C\u5C31\u53BB\u627E\u79AE\u5FB7\u5B78\u9577\u5427\u3002\u53EA\u662F\u2026\u2026\u5C0F\u5FC3\u90A3\u908A\u6709\u9EDE\u50CF\u8FF7\u5BAE\uFF0C\u5225\u4E00\u4E0D\u5C0F\u5FC3\u5C31\u8FF7\u8DEF\u4E86\u3002\u300D"
