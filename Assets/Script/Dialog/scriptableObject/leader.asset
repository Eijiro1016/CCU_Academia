  m_Script: {fileID: 11500000, guid: e159b0cc2492fbe4386f1c7f3eb38e91, type: 3}
  m_Name: leader
  m_EditorClassIdentifier: 
  lines:
  - "\u300C\u2026\u2026\u4F60\u600E\u9EBC\u6703\u77E5\u9053\u90A3\u500B\u540D\u5B57\uFF1F\u6211\u5011\u7576\u5E74\u6210\u7ACB\u7684\u7814\u7A76\u5C0F\u7D44\uFF0C\u539F\u672C\u53EA\u662F\u60F3\u89E3\u958B\u9CF3\u68A8\u6821\u5FBD\u80CC\u5F8C\u7684\u7531\u4F86\uFF0C\u7D50\u679C\u8D8A\u67E5\u8D8A\u6DF1\u3002\u6709\u4EBA\u8AAA\uFF0C\u2018\u9CF3\u68A8\u5370\u8A18\u2019\u4E0D\u53EA\u662F\u500B\u8C61\u5FB5\uFF0C\u5B83\u9084\u85CF\u8457\u4E00\u7A2E\u2026\u2026\u9078\u64C7\u3002 "
  - "\u53EF\u60DC\uFF0C\u6211\u5011\u6C92\u80FD\u627E\u5B8C\u6240\u6709\u7DDA\u7D22\uFF0C\u6709\u4EBA\u7562\u696D\uFF0C\u6709\u4EBA\u8F49\u7CFB\uFF0C\u53EA\u6709\u6211\u5076\u723E\u9084\u4F86\u9019\u88E1\u4FEE\u4FEE\u820A\u6A5F\u5668\u3001\u7FFB\u7FFB\u8A18\u9304\u3002"
  - "\u4E0D\u904E\uFF0C\u5982\u679C\u4F60\u771F\u7684\u6709\u5FC3\u60F3\u7E7C\u7E8C\uFF0C\u6211\u5EFA\u8B70\u4F60\u53BB\u627E\u6684\u9D3B\uFF0C\u4ED6\u662F\u6211\u5011\u5C0F\u7D44\u6700\u5F8C\u4E00\u4EFB\u7D00\u9304\u4FDD\u7BA1\u4EBA\u3002\u96D6\u7136\u4ED6\u73FE\u5728\u5728\u7BA1\u9662\uFF0C\u4F46\u2026\u2026\u60C5\u6CC1\u6709\u9EDE\u8907\u96DC\u3002"
  - "\u4ED6\u6700\u8FD1\u5FC3\u60C5\u5F88\u4F4E\u843D\uFF0C\u597D\u50CF\u70BA\u4E86\u611F\u60C5\u7684\u4E8B\u5FC3\u795E\u4E0D\u5BE7\u3002\u4E0D\u904E\u4F60\u8981\u662F\u80FD\u5F15\u8D77\u4ED6\u7684\u8208\u8DA3\uFF0C\u4E5F\u8A31\u4ED6\u6703\u9858\u610F\u958B\u53E3\u544A\u8A34\u4F60\u4E9B\u4EC0\u9EBC\u3002\u300D"
